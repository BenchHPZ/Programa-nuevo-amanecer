# Copiar a .env.local y llenar con las llaves reales del proyecto Supabase.
# .env.local está en .gitignore y NUNCA debe versionarse.

# ── Supabase ────────────────────────────────────────────────
# Públicas: viajan al navegador. La anon key es segura de exponer
# porque el acceso real lo controla Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ SOLO SERVIDOR. Ignora Row Level Security por completo.
# Nunca en un componente de cliente, nunca en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# ── Inicio de sesión con Google (opcional) ─────────────────────
# Estas dos NO van en .env.local: las lee el CLI de Supabase (godotenv,
# archivo .env en la raíz del repo), no Next.js — supabase/config.toml
# ([auth.external.google]) las referencia como env(...). En producción se
# configuran aparte, en el dashboard de Supabase (Authentication → Sign
# In / Providers → Google). Ver docs/DESPLIEGUE.md §6 para dar de alta el
# Client ID en Google Cloud Console. Tras llenarlas en .env, cambia
# `enabled = true` en config.toml y corre `supabase stop && supabase start`.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
